{
    "name": "dsh-outline-auto",
    "version": "0.7.3",
    "description": "DSH web plugin: search and read an Outline knowledge base from conversations, with approved, whitelist-guarded document writes.",
    "type": "module",
    "license": "MIT",
    "author": "huangfuren",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib",
        "src",
        "skills-adapter.js",
        "skills",
        "client.js",
        "cordis.patch.yml",
        "scripts/repair-profile.mjs",
        "dsh.plugin.json",
        "README.md",
        "README.zh-CN.md",
        "CHANGELOG.md"
    ],
    "keywords": [
        "deepseek",
        "harness",
        "dsh",
        "dsh-plugin",
        "outline",
        "knowledge-base"
    ],
    "engines": {
        "node": ">=22.19",
        "dsh": ">=0.1.5-rc.2 <0.2.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/huangfuren/dsh-outline-auto.git"
    },
    "homepage": "https://github.com/huangfuren/dsh-outline-auto#readme",
    "bugs": {
        "url": "https://github.com/huangfuren/dsh-outline-auto/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": "./lib/index.js",
        "./client": "./client.js",
        "./skills-adapter.js": "./skills-adapter.js",
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-ui-settings",
                "@deepseek-ai/dsh-client-ui-settings-plugins"
            ],
            "platform": "web"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "smoke": "node scripts/smoke.mjs",
        "verify": "pnpm typecheck && pnpm test && node scripts/smoke.mjs",
        "prepack": "pnpm build",
        "postinstall": "node scripts/repair-profile.mjs --quiet"
    },
    "dependencies": {
        "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": ">=4.0.0",
        "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2 <1.0.0",
        "@deepseek-ai/dsh-skill-filesystem": ">=0.1.5-rc.2 <1.0.0",
        "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <1.0.0",
        "@deepseek-ai/dsh-user-approval": ">=0.1.5-rc.2 <1.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "typescript": "^5.6.0",
        "vitest": "^4.1.8"
    }
}
